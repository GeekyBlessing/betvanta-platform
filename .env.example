# Required
# Supabase (see docs/SUPABASE.md). Server-only: never prefix these with NEXT_PUBLIC_.
DATABASE_URL=postgresql://betvanta_app.<ref>:<app-password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres   # app, least-privilege role, transaction pooler
MIGRATION_DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres # migrations only, session pooler
DATABASE_CA_CERT=                  # optional PEM from Supabase SSL settings; enables full certificate verification
# Do NOT add the Supabase service_role/secret key anywhere. The app does not use Supabase keys at all.
APP_URL=https://your-domain.com                             # used in email links and the Paystack callback URL
ADMIN_EMAILS=you@example.com                                # these emails get the admin role when they register

# Subscription payments (USD). Each provider is offered only when its keys are set. Use test keys first.
STRIPE_SECRET_KEY=                 # sk_test_...  webhook: {APP_URL}/api/webhooks/stripe (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=             # whsec_...
PAYSTACK_SECRET_KEY=               # optional; only if the merchant entity is in a Paystack country and approved for USD. webhook: {APP_URL}/api/webhooks/paystack
CRYPTO_PAYMENTS_ENABLED=false      # keep false until legal + provider approval for the merchant jurisdiction (see docs/COMPLIANCE.md)
NOWPAYMENTS_API_KEY=               # crypto: BTC, ETH, USDT (TRC-20). IPN URL is sent per invoice: {APP_URL}/api/webhooks/nowpayments
NOWPAYMENTS_IPN_SECRET=

# Discord community
DISCORD_INVITE_URL=                # the client's official invite (https://discord.gg/... ); used by every Join Discord button
DISCORD_WEBHOOK_URL=               # channel webhook for new-pick announcements (free picks show the selection; paid picks never do)
DISCORD_CLIENT_ID=                 # OAuth app; redirect URI: {APP_URL}/api/discord/callback
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=                 # bot in your server with Manage Roles + Create Instant Invite; its role must sit above the tier roles
DISCORD_GUILD_ID=
DISCORD_PREMIUM_ROLE_ID=
DISCORD_VIP_ROLE_ID=

# Email (Resend). Without it, emails are logged in Admin > Emails and NOT delivered.
RESEND_API_KEY=
EMAIL_FROM=BETVANTA <no-reply@your-domain.com>

# Sports data (API-Football). Without it, set ALLOW_SAMPLE_DATA=true for a labelled fictional league.
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUES=253,39,140,135,78,61   # MLS, EPL, La Liga, Serie A, Bundesliga, Ligue 1
API_FOOTBALL_SEASON=2025
ALLOW_SAMPLE_DATA=false

# AI analysis (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Daily automation: Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
APP_TIMEZONE=America/New_York      # display timezone for kickoff times
CRON_SECRET=
SESSION_TTL_DAYS=14
