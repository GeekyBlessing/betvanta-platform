# Required
# Supabase (see docs/SUPABASE.md). Server-only: never prefix these with NEXT_PUBLIC_.
DATABASE_URL=postgresql://betvanta_app.<ref>:<app-password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres   # app, least-privilege role, transaction pooler
MIGRATION_DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres # migrations only (npm run db:migrate), session pooler; NOT needed on Vercel
DATABASE_CA_CERT=                  # optional PEM from Supabase SSL settings; enables full certificate verification
# Never use the direct host db.<ref>.supabase.co (IPv6-only: causes ENETUNREACH on Vercel/GitHub).
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are not used by the app (server-side auth); optional and public if set.
# Do NOT add the Supabase service_role/secret key anywhere.
APP_URL=https://your-domain.com                             # used in email links and the Paystack callback URL
ADMIN_EMAILS=you@example.com                                # these emails get the admin role when they register

# Subscription payments (USD). Each provider is offered only when its keys are set. Use test keys first.
STRIPE_SECRET_KEY=                 # sk_test_...  webhook: {APP_URL}/api/webhooks/stripe (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=             # whsec_...
PAYSTACK_SECRET_KEY=               # optional; only if the merchant entity is in a Paystack country and approved for USD. webhook: {APP_URL}/api/webhooks/paystack
CRYPTO_PAYMENTS_ENABLED=false      # keep false until legal + provider approval for the merchant jurisdiction (see docs/COMPLIANCE.md)
NOWPAYMENTS_API_KEY=               # crypto: BTC, ETH, USDT (TRC-20). IPN URL is sent per invoice: {APP_URL}/api/webhooks/nowpayments
NOWPAYMENTS_IPN_SECRET=

# Discord community
DISCORD_INVITE_URL=https://discord.com/invite/STDJ29shZS   # official BETVANTA Discord (default in code); used by every Join Discord button
INSTAGRAM_URL=https://www.instagram.com/bet.vanta/       # official Instagram (default in code); footer and community page
X_URL=https://x.com/betvantaanalyst                       # official X account (default in code); footer, contact, community, homepage
DISCORD_WEBHOOK_URL=               # channel webhook for new-pick announcements (free picks show the selection; paid picks never do)
DISCORD_CLIENT_ID=                 # OAuth app; redirect URI: {APP_URL}/api/discord/callback
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=                 # bot in your server with Manage Roles + Create Instant Invite; its role must sit above the tier roles
DISCORD_GUILD_ID=
DISCORD_PREMIUM_ROLE_ID=
DISCORD_VIP_ROLE_ID=

# Email (Resend). Without it, emails are logged in Admin > Emails and NOT delivered.
RESEND_API_KEY=
EMAIL_FROM=BETVANTA <no-reply@your-domain.com>   # must be on a domain verified in Resend (a gmail.com address cannot be a sender); replies go to SUPPORT_EMAIL

# Sports data (API-Football). Without it, set ALLOW_SAMPLE_DATA=true for a labelled fictional league.
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUES=253,39,140,135,78,61   # MLS, EPL, La Liga, Serie A, Bundesliga, Ligue 1
API_FOOTBALL_SEASON=2025
ALLOW_SAMPLE_DATA=false

# AI analysis (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Daily automation: Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
SUPPORT_EMAIL=betvanta098@gmail.com   # customer support; shown on the site and used as Reply-To on all emails
SUPPORT_PHONE=+13143436703           # shown as (314) 343-6703
APP_TIMEZONE=America/New_York      # display timezone for kickoff times
CRON_SECRET=
SESSION_TTL_DAYS=14

# Payment assistant (manual payments, reviewed in Admin > Manual payments)
# Crypto wallets are fixed in src/lib/services/manual-payments/methods.ts. Crypto stays hidden until CRYPTO_PAYMENTS_ENABLED=true.
# Network each 0x wallet receives on, as confirmed by the client (for example: Ethereum (ERC-20)). ETH and USDT are NOT offered until set.
CRYPTO_ETH_NETWORK=
CRYPTO_USDT_NETWORK=
# Where "Contact BETVANTA on Discord" goes: a discord.com channel/user link or invite. Falls back to DISCORD_INVITE_URL.
DISCORD_SUPPORT_URL=

# On-chain verification before an admin can approve a crypto payment
ETHERSCAN_API_KEY=                 # free key from etherscan.io; enables automatic ETH and USDT checks on Ethereum mainnet
# MEMPOOL_API_BASE=https://mempool.space     # Bitcoin checks (default, no key)
# BTC_MIN_CONFIRMATIONS=2  ETH_MIN_CONFIRMATIONS=12
